# Copy to .streamlit/secrets.toml locally (that file is gitignored), and
# paste the same keys into Streamlit Cloud → Manage app → Settings →
# Secrets for the deployed app.
#
# NEVER commit real values. The repository is public.

# Managed AI endpoint. When set, the app defaults every AI feature to
# NVIDIA with no key entry, and the credential is never rendered to the
# user. Unset it and the app simply asks each analyst for their own key.
# Get one at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY = "nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional access gate. When set, the app requires this password before
# anything loads. Strongly recommended for any deployment that will hold
# client programmes.
# APP_PASSWORD = "choose-something-long"
