# Copy to secrets.env for the local docker-compose test (step 0).
# On AWS these SAME two names go into one Secrets Manager secret
# (README_DEPLOY.md step 3). No other place ever holds a credential.

# REQUIRED — the access password analysts type on first load.
APP_PASSWORD=change-me

# REQUIRED — the Gemini API key (Google AI Studio). This is the app's
# zero-click managed AI credential: analysts never see or handle it.
GEMINI_API_KEY=
