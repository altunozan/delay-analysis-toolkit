# Copy to secrets.env (gitignored) for local docker-compose runs.
# On AWS these SAME names live in one Secrets Manager secret — see
# DEPLOYMENT_GUIDE.md step 3. This is the single configuration layer:
# no other place in the system carries a credential.

# REQUIRED — the access-gate password analysts type on first load.
APP_PASSWORD=change-me

# The COAIR Gemini credential (single layer). The app pre-fills the
# Gemini key field from this; analysts never see or handle the key.
GEMINI_API_KEY=

# Optional extra providers. Leave NVIDIA_API_KEY EMPTY in COAIR —
# setting it would re-enable the managed NVIDIA default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
